# Files executed inside WSL/Linux must use LF, regardless of the
# checkout-side core.autocrlf setting. Without this, Windows clones
# with autocrlf=true convert these to CRLF and bash chokes on the \r.
*.sh         text eol=lf
*.py         text eol=lf
vpn.list     text eol=lf
direct.list  text eol=lf

# Windows-side scripts keep CRLF.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
