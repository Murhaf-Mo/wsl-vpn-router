# Copy this file to config.toml and fill in your values.
# config.toml is .gitignored on purpose — it holds plaintext secrets.

[vpn]
host = "vpn.example.com"
user = "your-username"
password = "your-vpn-password"
# group = "MFA-GROUP-NAME"   # uncomment if your server demands a group

[wsl]
distro = "Ubuntu-20.04"
# Sudo password for launching openconnect inside WSL.
# Leave empty if you set up a NOPASSWD sudoers rule (see README "Security").
sudo_password = "your-wsl-sudo-password"

[proxy]
http_port = 8888    # tinyproxy
pac_port  = 8889    # PAC server
bind_addr = "0.0.0.0"

[routing]
# "vpn-default"    : everything -> VPN, direct.list entries -> home
# "direct-default" : everything -> home, vpn.list entries -> VPN
mode = "vpn-default"
